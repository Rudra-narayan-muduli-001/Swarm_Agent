# ---------------------------------------------------------------------------
# Swarm Agent configuration
# ---------------------------------------------------------------------------

# Pick ONE model string. LiteLLM routes to the right provider by prefix:
#   OpenAI:     LLM_MODEL=gpt-4o-mini
#   Anthropic:  LLM_MODEL=claude-3-5-sonnet-latest
#   Gemini:     LLM_MODEL=gemini/gemini-1.5-flash
#   Local Ollama: LLM_MODEL=ollama/llama3.1
# Each agent can also override this with its own `model` field.
LLM_MODEL=gpt-4o-mini

# Optional per-agent temperature.
# LLM_TEMPERATURE=0.7

# Set the API key(s) that match your chosen provider:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Only needed for local models:
# OLLAMA_API_BASE=http://localhost:11434

# Optional: much better web search (https://tavily.com). When unset, the
# built-in DuckDuckGo search is used instead.
# TAVILY_API_KEY=

# Optional: server port (default 8000)
# PORT=8000
